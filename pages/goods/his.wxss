/* ==================== 全局样式 ==================== */
page {
  background: #f5f5f5;
  min-height: 100vh;
}

page, view, image, input {
  display: block;
  box-sizing: border-box;
}

/* ==================== 搜索栏 ==================== */
.search-container {
  background: #fff;
  padding: 16rpx 16rpx 0;
}

/* ==================== 筛选条件 ==================== */
.filters-wrapper {
  background: #fff;
  padding: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filters {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e5e5e5;
}

.filter-item {
  flex: 1;
  font-size: 28rpx;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
}

.picker-content.active {
  color: #e4393c;
  font-weight: 500;
}

.picker-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.picker-text {
  font-size: 28rpx;
}

.picker-arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
  color: #999;
}

.filter-divider {
  width: 1rpx;
  height: 28rpx;
  background: #e5e5e5;
  margin: 0 20rpx;
}

/* ==================== 空状态 ==================== */
.empty-container {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background: #fff;
  margin-top: 20rpx;
}

.empty-content {
  text-align: center;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.empty-btn {
  display: inline-block;
  background: #e4393c;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.empty-btn:active {
  background: #c81623;
}

/* ==================== 商品容器 ==================== */
.goods-container {
  padding: 20rpx 0 140rpx; /* 底部留出浮动按钮空间 */
}

.list2-box {
  padding: 0 16rpx;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}

/* ==================== 商品卡片 ==================== */
.list2 {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
}

.goods-card {
  display: block;
}

/* 图片区域 */
.img-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
  background: #f8f8f8;
}

.img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.viewed-badge {
  position: absolute;
  top: 12rpx;
  left: 0;
  background: rgba(228, 57, 60, 0.85);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 0 20rpx 20rpx 0;
}

/* 商品信息 */
.goods-info {
  padding: 16rpx 16rpx 8rpx;
  flex: 1;
}

.title {
  color: #333;
  font-size: 26rpx;
  line-height: 38rpx;
  height: 76rpx;
  font-weight: 400;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}

.price-section {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sales-info {
  font-size: 22rpx;
  color: #999;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag-text {
  font-size: 20rpx;
  color: #999;
  background: #f7f7f7;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* ==================== 底部操作栏 ==================== */
.card-actions {
  display: flex;
  align-items: center;
  padding: 10rpx 12rpx 14rpx;
  gap: 10rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: transform 0.15s ease, opacity 0.15s ease;
  position: relative;
}

.action-btn:active {
  transform: scale(0.93);
  opacity: 0.75;
}

/* 再看看 */
.look-btn {
  flex: 1;
  background: #f5f5f5;
  color: #555;
}

/* 加入购物车 */
.add-cart-btn {
  width: 64rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #e4393c 0%, #c81623 100%);
  overflow: visible;
}

.cart-action-icon {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) invert(1);
}

/* 加购数量徽章 */
.action-badge {
  position: absolute;
  top: -12rpx;
  right: -10rpx;
  background: #ff9500;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  z-index: 10;
}

/* ==================== 底部加载状态 ==================== */
.load-more {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #bbb;
  letter-spacing: 1rpx;
}

.load-more-hint {
  color: #ccc;
}

/* ==================== 浮动购物车 ==================== */
.float-cart {
  position: fixed;
  right: 36rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #e4393c 0%, #c81623 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(228, 57, 60, 0.45);
  z-index: 100;
  transition: transform 0.2s ease;
  overflow: visible;
}

.float-cart:active {
  transform: scale(0.9);
}

.float-cart-icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1);
}

.float-cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #ff9500;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
  z-index: 101;
}
