<van-sticky>
  <view class="header">
    <view class="search">
      <input type="text" placeholder="输入搜索关键词" value="{{name}}" bindinput="bindinput" bindconfirm="bindconfirm"></input>
      <image src="/images/icon/search.svg" bindtap="search"></image>
    </view>
    <image class="show-type" src="/images/icon/list{{listType}}.svg" bindtap="changeShowType"></image>
  </view>
  <view class="filters">
    <view class="item {{orderBy==''?'active':''}}" data-val="" bindtap="filter">综合</view>
    <view class="item {{orderBy=='addedDown'?'active':''}}" data-val="addedDown" bindtap="filter">新品</view>
    <view class="item {{orderBy=='ordersDown'?'active':''}}" data-val="ordersDown" bindtap="filter">销量</view>
    <view class="item {{orderBy=='priceUp'?'active':''}}" data-val="priceUp" bindtap="filter">价格</view>
  </view>
</van-sticky>

<van-empty wx:if="{{ !goods || goods.length == 0 }}" description="暂无商品" />

<wxs module="goodsDetailPage">
module.exports = {
  url : function(item) {
    return '/pages/goods-details/index?id=' + item.id
  }
}
</wxs>

<!-- ========== 列表模式1：横向卡片 ========== -->
<block wx:if="{{listType == 1}}">
  <view class="list1" wx:for="{{goods}}" wx:key="id">
    <navigator url="{{ goodsDetailPage.url(item) }}">
      <image class="img" mode="aspectFill" src="{{item.pic}}"></image>
    </navigator>
    <view class="goods-info">
      <view class="title ellipsis">
        <navigator url="{{ goodsDetailPage.url(item) }}">{{item.name}}</navigator>
      </view>
      <view wx:if="{{item.characteristic}}" class="characteristic van-multi-ellipsis--l2" style="padding:0;-webkit-line-clamp: 1;">{{item.characteristic}}</view>
      <view class="price">
        <block wx:if="{{(!item.minPrice || item.minPrice <= 0) && (!item.minScore || item.minScore <= 0)}}">
          <view class="gl-price-free-badge">免费</view>
          <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="originalPrice">¥ {{item.originalPrice}}</text>
        </block>
        <block wx:elif="{{(!item.minPrice || item.minPrice <= 0) && item.minScore > 0}}">
          <view class="gl-price-score-wrap">
            <text class="gl-price-score-num">{{item.minScore}}</text>
            <text class="gl-price-score-unit">积分</text>
          </view>
          <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="originalPrice">¥ {{item.originalPrice}}</text>
        </block>
        <block wx:elif="{{item.minPrice > 0 && item.minScore > 0}}">
          <view class="gl-price-combo-wrap">
            <view class="gl-price-money-wrap">
              <text class="gl-price-symbol">¥</text>
              <text class="gl-price-main">{{item.minPrice}}</text>
            </view>
            <text class="gl-price-plus">+</text>
            <view class="gl-price-score-wrap">
              <text class="gl-price-score-num">{{item.minScore}}</text>
              <text class="gl-price-score-unit">积分</text>
            </view>
          </view>
          <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="originalPrice">¥ {{item.originalPrice}}</text>
        </block>
        <block wx:else>
          <view class="gl-price-money-wrap">
            <text class="gl-price-symbol">¥</text>
            <text class="gl-price-main">{{item.minPrice}}</text>
          </view>
          <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="originalPrice">¥ {{item.originalPrice}}</text>
        </block>
      </view>
      <view class="buy-info">
        <view wx:if="{{ show_seller_number == '1' }}" class="num">已售出{{item.numberSells}}件</view>
        <!-- 购物车按钮 + 数量红点 -->
        <view class="car" data-id="{{item.id}}" bindtap="addShopCar">
          <image class="car-icon" src="/images/icon/car.svg"></image>
          <view wx:if="{{item.cartNum && item.cartNum > 0}}" class="car-badge">
            {{item.cartNum > 99 ? '99+' : item.cartNum}}
          </view>
        </view>
      </view>
    </view>
  </view>
</block>

<!-- ========== 列表模式2：网格布局 ========== -->
<view wx:if="{{listType == 2}}" class="list2-box">
  <view class="list2" wx:for="{{goods}}" wx:key="id">
    <navigator url="{{ goodsDetailPage.url(item) }}">
      <image class="img" mode="aspectFill" src="{{item.pic}}"></image>
    </navigator>
    <view class="goods-info">
      <view class="title van-multi-ellipsis--l2">
        <navigator url="{{ goodsDetailPage.url(item) }}">{{item.name}}</navigator>
      </view>
      <view wx:if="{{item.characteristic}}" class="characteristic van-multi-ellipsis--l2" style="padding:0;-webkit-line-clamp: 1;">{{item.characteristic}}</view>
      <view class="price">
        <block wx:if="{{(!item.minPrice || item.minPrice <= 0) && (!item.minScore || item.minScore <= 0)}}">
          <view class="gl-price-free-badge">免费</view>
          <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="originalPrice">¥ {{item.originalPrice}}</text>
        </block>
        <block wx:elif="{{(!item.minPrice || item.minPrice <= 0) && item.minScore > 0}}">
          <view class="gl-price-score-wrap">
            <text class="gl-price-score-num">{{item.minScore}}</text>
            <text class="gl-price-score-unit">积分</text>
          </view>
          <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="originalPrice">¥ {{item.originalPrice}}</text>
        </block>
        <block wx:elif="{{item.minPrice > 0 && item.minScore > 0}}">
          <view class="gl-price-combo-wrap">
            <view class="gl-price-money-wrap">
              <text class="gl-price-symbol">¥</text>
              <text class="gl-price-main">{{item.minPrice}}</text>
            </view>
            <text class="gl-price-plus">+</text>
            <view class="gl-price-score-wrap">
              <text class="gl-price-score-num">{{item.minScore}}</text>
              <text class="gl-price-score-unit">积分</text>
            </view>
          </view>
          <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="originalPrice">¥ {{item.originalPrice}}</text>
        </block>
        <block wx:else>
          <view class="gl-price-money-wrap">
            <text class="gl-price-symbol">¥</text>
            <text class="gl-price-main">{{item.minPrice}}</text>
          </view>
          <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="originalPrice">¥ {{item.originalPrice}}</text>
        </block>
      </view>
      <view class="buy-info">
        <view wx:if="{{ show_seller_number == '1' }}" class="num">{{item.numberOrders}}人已购{{item.numberSells}}件</view>
        <!-- 购物车按钮 + 数量红点 -->
        <view class="car" data-id="{{item.id}}" bindtap="addShopCar">
          <image class="car-icon" src="/images/icon/car.svg"></image>
          <view wx:if="{{item.cartNum && item.cartNum > 0}}" class="car-badge">
            {{item.cartNum > 99 ? '99+' : item.cartNum}}
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 右下角浮动购物车 -->
<view class="float-cart" bindtap="goToCart">
  <image class="float-cart-icon" src="/images/icon/car.svg"></image>
  <view wx:if="{{totalCartNum && totalCartNum > 0}}" class="float-cart-badge">
    {{totalCartNum > 99 ? '99+' : totalCartNum}}
  </view>
</view>

<!-- SKU 选择弹窗 -->
<goods-pop skuCurGoodsBaseInfo="{{ skuCurGoods }}" bind:addCartSuccess="onAddCartSuccess" />
