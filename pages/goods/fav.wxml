<view class="fav-container">
  <!-- 商品列表 -->
  <view class="list2-box" wx:if="{{goods && goods.length > 0}}">
    <block wx:for="{{goods}}" wx:key="id" wx:for-index="index">

      <!-- 自营商品 -->
      <view wx:if="{{ item.type == 0 }}" class="list2">
        <!-- 商品图片 + 加购悬浮按钮 -->
        <view class="img-wrapper">
          <navigator url="/pages/goods-details/index?id={{item.goodsId}}" class="img-link">
            <image class="img" mode="aspectFill" src="{{item.pic}}"></image>
          </navigator>
          <!-- 加购按钮（右下角悬浮） -->
          <view class="card-cart-btn" data-idx="{{index}}" bindtap="addShopCar">
            <view class="cart-icon-wrap">
              <image class="cart-icon" src="/images/icon/car.svg"></image>
              <!-- 购物车商品数量红点 -->
              <view wx:if="{{item.cartNum && item.cartNum > 0}}" class="cart-badge">{{item.cartNum > 99 ? '99+' : item.cartNum}}</view>
            </view>
          </view>
        </view>

        <!-- 商品信息 -->
        <view class="goods-info">
          <navigator url="/pages/goods-details/index?id={{item.goodsId}}" class="title-link">
            <view class="title ellipsis">{{item.goodsName}}</view>
          </navigator>
          <!-- 价格 -->
          <view wx:if="{{ item.minPrice }}" class="price-row">
            <text class="price-symbol">¥</text>
            <text class="price-main">{{item.minPrice || item.price || '--'}}</text>
          </view>
        </view>

        <!-- 底部操作栏 -->
        <view class="card-actions">
          <!-- 删除收藏 icon -->
          <view class="action-btn delete-btn" data-idx="{{index}}" bindtap="removeFav">
            <image class="action-icon" src="/images/icon/delete.svg"></image>
          </view>
          <!-- 加入购物车 icon（宽按钮） -->
          <view class="action-btn add-cart-btn" data-idx="{{index}}" bindtap="addShopCar">
            <image class="action-icon cart-action-icon" src="/images/icon/car.svg"></image>
            <view wx:if="{{item.cartNum && item.cartNum > 0}}" class="action-badge">{{item.cartNum > 99 ? '99+' : item.cartNum}}</view>
          </view>
        </view>
      </view>

      <!-- 第三方商品（无加购，只有跳转+删除） -->
      <view wx:else class="list2">
        <view class="img-wrapper">
          <navigator url="{{item.json.wxaurl}}" class="img-link">
            <image class="img" mode="aspectFill" src="{{item.json.pic}}"></image>
          </navigator>
        </view>
        <view class="goods-info">
          <navigator url="{{item.json.wxaurl}}" class="title-link">
            <view class="title ellipsis">{{item.json.name}}</view>
          </navigator>
        </view>
        <view class="card-actions card-actions--single">
          <view class="action-btn delete-btn" data-idx="{{index}}" bindtap="removeFav">
            <image class="action-icon" src="/images/icon/delete.svg"></image>
          </view>
        </view>
      </view>

    </block>
    <!-- 底部加载状态 -->
    <view class="load-more" wx:if="{{goods && goods.length > 0}}">
      <text wx:if="{{noMore}}" class="load-more-text">已加载全部收藏</text>
      <text wx:else class="load-more-text load-more-loading">上拉加载更多</text>
    </view>
  </view>

  <!-- 空状态：仅在数据加载完成后、且确实没有商品时显示 -->
  <view class="empty-container" wx:if="{{loaded && (!goods || goods.length == 0)}}">
    <view class="empty-card">
      <view class="empty-icon">💝</view>
      <view class="empty-title">还没有收藏商品</view>
      <view class="empty-desc">快去发现心仪的商品吧</view>
    </view>
  </view>

  <!-- 右下角浮动购物车按钮 -->
  <view class="float-cart" bindtap="goToCart">
    <image class="float-cart-icon" src="/images/icon/car.svg"></image>
    <view wx:if="{{totalCartNum && totalCartNum > 0}}" class="float-cart-badge">{{totalCartNum > 99 ? '99+' : totalCartNum}}</view>
  </view>
</view>

<!-- SKU 选择弹窗 -->
<goods-pop skuCurGoodsBaseInfo="{{ skuCurGoods }}" bind:addCartSuccess="onAddCartSuccess" />
